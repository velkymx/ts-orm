{
  "name": "vibeorm",
  "version": "1.6.0",
  "description": "A lightweight, powerful ORM with Eloquent-like syntax for Node.js and MySQL2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/velkymx/ts-orm.git"
  },
  "bugs": {
    "url": "https://github.com/velkymx/ts-orm/issues"
  },
  "homepage": "https://github.com/velkymx/ts-orm#readme",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "vibeorm": "./bin/cli.js"
  },
  "keywords": [
    "orm",
    "vibe",
    "vibeorm",
    "mysql",
    "mysql2",
    "eloquent",
    "query-builder",
    "model",
    "crud",
    "sql",
    "database",
    "nodejs",
    "javascript",
    "typescript"
  ],
  "author": "TechnoSorcery.com",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "mysql2": "^3.14.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "testEnvironment": "node",
    "transform": {}
  }
}
