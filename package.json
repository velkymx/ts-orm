  "devDependencies": {
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "jest": {
