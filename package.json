{
  "name": "@velkymx/ts-orm",
  "version": "2.0.0-dev.0",
  "description": "A lightweight, type-safe TypeScript ORM built on MySQL2 using self-documenting structs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velkymx/ts-orm.git"
  },
  "bugs": {
    "url": "https://github.com/velkymx/ts-orm/issues"
  },
  "homepage": "https://github.com/velkymx/ts-orm#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "ts-orm": "./dist/bin/cli.js"
  },
  "keywords": [
    "orm",
    "mysql",
    "crud",
    "typescript",
    "type-safe",
    "validator",
    "mysql2",
    "nodejs"
  ],
  "author": "TechnoSorcery.com",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.7",
    "mysql2": "^3.14.0",
    "uuid": "^14.0.3"
  },
  "peerDependencies": {
    "mssql": ">=11",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "mssql": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "mssql": "^12.7.6",
    "oxlint": "^1.88.0",
    "pg": "^8.23.1",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests",
    "prepublishOnly": "npm run build && npm test"
  }
}
