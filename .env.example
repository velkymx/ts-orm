# VibeORM connection configuration. Copy to `.env` and fill in.
# Loaded once on import (dotenv). DB_HOST and DB_DATABASE are required —
# VibeORM warns at startup if they're missing.

# --- Connection (required) ---
DB_HOST=localhost
DB_DATABASE=myapp
DB_USER=root
DB_PASSWORD=

# --- Connection (optional) ---
DB_PORT=3306                 # default 3306

# --- TLS (managed engines like RDS/Aurora usually require it) ---
# DB_SSL=Amazon RDS          # mysql2's bundled RDS CA bundle (verified)
# DB_SSL=true                # verified TLS
# DB_SSL=no-verify           # TLS without certificate verification (self-signed)

# --- Pool tuning / observability (optional) ---
# DB_CONNECTION_LIMIT=10     # max pooled connections (mysql2 default = 10)
# DB_CONNECT_TIMEOUT=10000   # connection timeout, ms
# DB_SLOW_QUERY_MS=200       # warn-log queries slower than this (0/unset = off)
